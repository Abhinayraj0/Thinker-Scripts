---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact Us"
	description="Contact Thinker Scripts for editorial questions, corrections, collaboration requests, and general inquiries about the tech philosophy publication."
	keywords={[
		'contact Thinker Scripts',
		'tech philosophy blog contact',
		'software engineering philosophy publication',
		'developer writing inquiries',
	]}
>
	<section class="mx-auto max-w-7xl px-5 py-14 sm:px-6 lg:px-8">
		<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">CONTACT US</p>
		<h1 class="mt-4 max-w-4xl text-5xl font-semibold leading-none text-pretty text-neutral-950 sm:text-7xl dark:text-white">
			Reach Thinker Scripts.
		</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-neutral-600 dark:text-neutral-300">
			Use this page for editorial questions, corrections, collaboration requests, and general inquiries related to Thinker Scripts.
		</p>
	</section>

	<section class="border-y border-neutral-200 bg-neutral-50 py-14 dark:border-neutral-800 dark:bg-neutral-950">
		<div class="mx-auto grid max-w-7xl gap-6 px-5 sm:px-6 lg:grid-cols-3 lg:px-8">
			<div class="border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950">
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">GENERAL</p>
				<h2 class="mt-3 text-xl font-semibold text-neutral-950 dark:text-white">Inquiries</h2>
				<p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
					Email <a class="underline underline-offset-4 hover:text-neutral-950 dark:hover:text-white" href="mailto:hello@thinkerscripts.com">hello@thinkerscripts.com</a> for general questions.
				</p>
			</div>
			<div class="border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950">
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">EDITORIAL</p>
				<h2 class="mt-3 text-xl font-semibold text-neutral-950 dark:text-white">Corrections</h2>
				<p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
					Send article corrections with the page URL, section title, and the specific issue you noticed.
				</p>
			</div>
			<div class="border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950">
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">RESPONSE</p>
				<h2 class="mt-3 text-xl font-semibold text-neutral-950 dark:text-white">Timing</h2>
				<p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
					We review messages periodically and prioritize corrections, security concerns, and time-sensitive publication issues.
				</p>
			</div>
		</div>
	</section>
</Layout>
