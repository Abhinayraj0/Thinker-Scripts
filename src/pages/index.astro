---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import PhilosophyFAQ from '../components/PhilosophyFAQ.astro';
import { getCollection } from 'astro:content';
import archiveGrid from '../assets/archive-grid.svg';
import interfaceLines from '../assets/interface-lines.svg';
import memoryField from '../assets/memory-field.svg';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featuredPost = posts[0];
const recentPosts = posts.slice(1, 3);
const pageLinks = [
	{
		href: '/about-us/',
		label: 'About Us',
		description: 'Learn the editorial focus behind Thinker Scripts and its long-form approach to software thinking.',
	},
	{
		href: '/contact-us/',
		label: 'Contact Us',
		description: 'Send questions, corrections, collaboration notes, and publication-related inquiries.',
	},
	{
		href: '/privacy-policy/',
		label: 'Privacy Policy',
		description: 'Review how the site handles basic technical data, messages, browser storage, and external links.',
	},
	{
		href: '/terms-and-conditions/',
		label: 'Terms & Conditions',
		description: 'Read the terms for using the site, sharing content, and relying on published material.',
	},
];
---

<Layout
	title="Thinker Scripts"
	description="A tech philosophy blog for developers exploring the philosophy of software engineering, systems thinking software design, epistemology in tech, and first principles software development."
	keywords={[
		'philosophy of software engineering',
		'tech philosophy blog',
		'systems thinking software design',
		'epistemology in tech',
		'first principles software development',
		'philosophical developer',
		'deep reading for developers',
		'critical thinking in computer science',
	]}
>
	<section class="mx-auto grid max-w-7xl gap-10 px-5 pb-16 pt-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.72fr)] lg:px-8 lg:pb-24 lg:pt-24">
		<div class="max-w-5xl self-center">
			<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">THINKERSCRIPTS.COM / SYSTEMS READING DESK</p>
			<h1 class="mt-5 max-w-5xl text-5xl font-semibold leading-none text-pretty text-neutral-950 sm:text-7xl lg:text-8xl dark:text-white">
				Software thinking, built for serious readers.
			</h1>
			<p class="mt-7 max-w-3xl text-lg leading-8 text-neutral-600 sm:text-xl sm:leading-9 dark:text-neutral-300">
				Dense essays on software engineering philosophy, cognitive architectures for programming, systems design, and critical thinking, wrapped in a reader interface that remembers how you work.
			</p>
			<div class="mt-10 flex flex-wrap items-center gap-3">
				<a class="btn btn-primary" href="/library/">Browse Library</a>
				<a class="btn btn-secondary" href="/topics/">Explore Topics</a>
			</div>
			<div class="mt-10 grid max-w-3xl gap-3 sm:grid-cols-3">
				<div class="metric">
					<span>Essays</span>
					<strong>{posts.length} published</strong>
				</div>
				<div class="metric">
					<span>Reader Modes</span>
					<strong>Theme / Zen / Search</strong>
				</div>
				<div class="metric">
					<span>Ops</span>
					<strong>Local + GitHub publish</strong>
				</div>
			</div>
		</div>
		<div class="home-system-visual" aria-label="Thinker Scripts interface system preview">
			<img src={interfaceLines.src} alt="Dark interface writing panel preview" loading="eager" />
			<div class="home-system-visual__grid">
				<img src={memoryField.src} alt="Memory graph preview" loading="lazy" />
				<img src={archiveGrid.src} alt="Archive grid preview" loading="lazy" />
			</div>
			<div class="home-system-visual__status">
				<span>Reader Engine</span>
				<strong>Live local memory</strong>
				<small>Library filters, post overrides, reading controls, and control-center backups run in the browser.</small>
			</div>
		</div>
	</section>

	<section class="border-y border-neutral-200 bg-neutral-50 py-14 dark:border-neutral-800 dark:bg-neutral-950">
		<div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-6 lg:grid-cols-[1fr_0.72fr] lg:px-8">
			<div>
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">FEATURED ESSAY</p>
				<h2 class="mt-3 text-3xl font-semibold text-neutral-950 dark:text-white">Start with the newest long read.</h2>
				<p class="mt-4 max-w-2xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">
					Read essays about building cognitive frameworks for complex systems, first principles software development, and the mechanics of context-aware reading interfaces.
				</p>
			</div>
			<div data-home-featured-posts>
				{featuredPost && <PostCard post={featuredPost} />}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-5 py-14 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">RECENT POSTS</p>
				<h2 class="mt-3 text-3xl font-semibold text-neutral-950 dark:text-white">Continue through the archive.</h2>
			</div>
			<a class="btn btn-secondary" href="/library/">Open Full Library</a>
		</div>
		<div class="mt-8 grid gap-4" data-home-recent-posts>
			{recentPosts.map((post) => <PostCard post={post} />)}
		</div>
	</section>

	<section class="border-y border-neutral-200 bg-neutral-50 py-14 dark:border-neutral-800 dark:bg-neutral-950">
		<div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
			<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div>
					<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">SITE PAGES</p>
					<h2 class="mt-3 text-3xl font-semibold text-neutral-950 dark:text-white">Company and policy pages.</h2>
				</div>
				<p class="max-w-xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">
					Core pages are available as separate crawlable routes for readers, search engines, and site governance.
				</p>
			</div>
			<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{pageLinks.map((page) => (
					<a class="topic-row items-start" href={page.href}>
						<span>
							<strong class="mb-3 block font-mono text-xs font-medium text-neutral-500 dark:text-neutral-400">PAGE</strong>
							<span class="block text-xl">{page.label}</span>
							<small class="mt-3 block text-sm font-normal leading-6 text-neutral-600 dark:text-neutral-300">{page.description}</small>
						</span>
						<strong aria-hidden="true">Open</strong>
					</a>
				))}
			</div>
		</div>
	</section>

	<PhilosophyFAQ />
</Layout>
