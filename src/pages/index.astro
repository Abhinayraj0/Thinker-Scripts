---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const types = [...new Set(posts.map((post) => post.data.type))];
const categories = [...new Set(posts.flatMap((post) => post.data.categories))];
const ranges = [
	{ label: '< 8 Min', value: 'short', min: 0, max: 8 },
	{ label: '8-15 Min', value: 'medium', min: 8, max: 15 },
	{ label: '15+ Min', value: 'long', min: 15, max: 999 },
];
---

<Layout
	title="Thinker Scripts"
	description="A high-performance long-form reading platform for deep technical, historical, and cultural essays."
>
	<section class="mx-auto grid max-w-7xl gap-12 px-5 pb-16 pt-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:pb-24 lg:pt-28">
		<div class="max-w-3xl">
			<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">THINKERSCRIPTS.COM</p>
			<h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-none text-pretty text-neutral-950 sm:text-6xl dark:text-white">
				Deep reading for technical minds.
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-600 dark:text-neutral-300">
				Thinker Scripts publishes dense, cross-disciplinary essays with contextual footnotes, fast taxonomy search, and an immersive reader built for people who do not want to lose their place.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a class="btn btn-primary" href="#library">Browse Library</a>
				<a class="btn btn-secondary" href="/posts/systems-that-remember/">Open Featured Essay</a>
			</div>
		</div>
		<div class="grid content-end gap-3 border border-neutral-200 bg-white p-4 shadow-vercel dark:border-neutral-800 dark:bg-neutral-950">
			<div class="flex items-center justify-between border-b border-neutral-200 pb-3 dark:border-neutral-800">
				<span class="font-mono text-xs text-neutral-500">READER ENGINE</span>
				<span class="h-2 w-2 rounded-full bg-blue-500"></span>
			</div>
			<div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
				<div class="metric">
					<span>Context Panel</span>
					<strong>No lost place</strong>
				</div>
				<div class="metric">
					<span>Reading Ticker</span>
					<strong>Live ETA</strong>
				</div>
				<div class="metric">
					<span>Zen Mode</span>
					<strong>Clean text</strong>
				</div>
			</div>
			<div class="mt-2 border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-900">
				<p class="font-mono text-xs text-neutral-500">ACTIVE METHODS</p>
				<ul class="mt-4 grid gap-3 text-sm text-neutral-700 dark:text-neutral-300">
					<li class="flex gap-3"><span class="mt-2 h-px w-6 bg-neutral-950 dark:bg-white"></span>Split-screen citations and internal reference previews.</li>
					<li class="flex gap-3"><span class="mt-2 h-px w-6 bg-neutral-950 dark:bg-white"></span>Client-side filters by type, topic, and reading time.</li>
					<li class="flex gap-3"><span class="mt-2 h-px w-6 bg-neutral-950 dark:bg-white"></span>Reader controls for typeface, scale, and line-height.</li>
				</ul>
			</div>
		</div>
	</section>

	<section id="library" class="border-y border-neutral-200 bg-neutral-50 py-14 dark:border-neutral-800 dark:bg-neutral-950">
		<div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8" data-library>
			<div class="flex flex-col gap-5 border-b border-neutral-200 pb-8 md:flex-row md:items-end md:justify-between dark:border-neutral-800">
				<div>
					<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">CONTENT INDEX</p>
					<h2 class="mt-3 text-3xl font-semibold text-neutral-950 dark:text-white">Filter by intent.</h2>
				</div>
				<p class="max-w-xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">
					Every filter updates instantly and mirrors state into the URL, so curated reading paths are shareable.
				</p>
			</div>

			<div class="mt-8 grid gap-6 lg:grid-cols-[280px_1fr]">
				<aside class="h-fit border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-950">
					<div class="flex items-center justify-between">
						<h3 class="text-sm font-medium text-neutral-950 dark:text-white">Filters</h3>
						<button class="text-sm text-neutral-500 transition-colors hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" type="button" data-clear-filters>
							Clear
						</button>
					</div>
					<div class="mt-5 space-y-6">
						<div>
							<p class="filter-label">Type</p>
							<div class="mt-3 flex flex-wrap gap-2" data-filter-group="type">
								{types.map((type) => <button class="filter-chip" type="button" data-filter="type" data-value={type}>{type}</button>)}
							</div>
						</div>
						<div>
							<p class="filter-label">Discipline</p>
							<div class="mt-3 flex flex-wrap gap-2" data-filter-group="category">
								{categories.map((category) => <button class="filter-chip" type="button" data-filter="category" data-value={category}>{category}</button>)}
							</div>
						</div>
						<div>
							<p class="filter-label">Reading Time</p>
							<div class="mt-3 flex flex-wrap gap-2" data-filter-group="time">
								{ranges.map((range) => <button class="filter-chip" type="button" data-filter="time" data-value={range.value} data-min={range.min} data-max={range.max}>{range.label}</button>)}
							</div>
						</div>
					</div>
				</aside>

				<div>
					<div class="mb-4 flex items-center justify-between text-sm text-neutral-500 dark:text-neutral-400">
						<span><strong class="font-medium text-neutral-950 dark:text-white" data-result-count>{posts.length}</strong> essays found</span>
						<span class="font-mono text-xs">STATIC FIRST / CLIENT FILTERED</span>
					</div>
					<div class="grid gap-4" data-post-list>
						{posts.map((post) => <PostCard post={post} />)}
					</div>
					<p class="hidden border border-neutral-200 bg-white p-6 text-sm text-neutral-500 dark:border-neutral-800 dark:bg-neutral-950" data-empty-state>
						No essays match this filter set.
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
