---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = new Intl.DateTimeFormat('en', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
}).format(post.data.publishedAt);
const articleKeywords = [
	...post.data.tags,
	...post.data.categories,
	post.data.type,
	'philosophy of software engineering',
	'systems thinking software design',
	'deep reading for developers',
	'critical thinking in computer science',
];
---

<Layout
	title={post.data.title}
	description={post.data.description}
	keywords={articleKeywords}
	type="article"
	publishedAt={post.data.publishedAt}
	updatedAt={post.data.updatedAt ?? post.data.publishedAt}
	zenCapable
>
	<section class="border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950" data-post-hero>
		<div class="mx-auto max-w-5xl px-5 py-12 sm:px-6 lg:px-8">
			<div class="max-w-4xl">
				<a class="text-sm text-neutral-500 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="/library/">&lt;- Back to Library</a>
				<p class="mt-8 font-mono text-xs text-neutral-500">{post.data.type} / {published} / {post.data.readingMinutes} Min</p>
				<h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-pretty text-neutral-950 sm:text-6xl dark:text-white">{post.data.title}</h1>
				<p class="mt-6 max-w-3xl text-lg leading-8 text-neutral-600 dark:text-neutral-300">{post.data.description}</p>
			</div>
		</div>
	</section>

	<div class="reading-progress-shell" data-reading-widget>
		<div class="reading-progress-widget" aria-label="Reading progress">
			<div class="reading-progress-meta">
				<strong data-time-remaining data-word-count={post.body.split(/\s+/).length}>...</strong>
				<span data-progress-percent>0%</span>
			</div>
			<div class="reading-progress-track" data-progress-meter aria-label="Reading progress">
				<span data-progress-bar></span>
			</div>
			<div class="reading-progress-orb" aria-hidden="true">
				<svg viewBox="0 0 48 48">
					<circle class="reading-progress-orb__track" cx="24" cy="24" r="20"></circle>
					<circle class="reading-progress-orb__value" cx="24" cy="24" r="20" pathLength="100" data-zen-progress-ring></circle>
				</svg>
			</div>
		</div>
	</div>

	<div class="mx-auto max-w-5xl px-5 py-12 sm:px-6 lg:px-8" data-reading-layout>
		<article class="min-w-0 w-full max-w-2xl lg:mx-auto" data-reading-article>
			<div class="reader-prose max-w-prose" data-reader-content>
				<Content />
			</div>
		</article>

	</div>

	<div class="reader-dock" data-reader-dock data-open="false">
		<button class="reader-dock-trigger fixed bottom-6 left-1/2 z-40 -translate-x-1/2 backdrop-blur-md" type="button" data-reader-dock-trigger aria-label="Open reader tools" aria-expanded="false">
			<span aria-hidden="true">^</span>
		</button>
		<div class="reader-dock-panel" role="dialog" aria-label="Reader tools">
			<div class="reader-dock-tabs" role="tablist" aria-label="Reader tool tabs">
				<button class="reader-dock-tab" type="button" data-reader-tab="inspect" aria-pressed="true">Inspect</button>
				<button class="reader-dock-tab" type="button" data-reader-tab="search" aria-pressed="false">Search</button>
				<button class="reader-dock-tab" type="button" data-reader-tab="settings" aria-pressed="false">Settings</button>
			</div>

			<section class="reader-dock-pane" data-reader-pane="inspect">
				<div class="reader-toc" data-reader-toc aria-label="Article sections"></div>
			</section>

			<section class="reader-dock-pane" data-reader-pane="search" hidden>
				<label class="reader-search-field">
					<span>Find in essay</span>
					<input type="search" data-reader-search placeholder="Search article text" autocomplete="off" />
				</label>
				<div class="reader-search-actions">
					<button class="reader-arrow-btn" type="button" data-search-prev aria-label="Previous match">▲</button>
					<button class="reader-arrow-btn" type="button" data-search-next aria-label="Next match">▼</button>
					<span data-search-count>0 matches</span>
				</div>
			</section>

			<section class="reader-dock-pane" data-reader-pane="settings" hidden>
				<div class="reader-settings-grid">
					<label class="reader-setting">
						<span>Speed</span>
						<select class="reader-select" name="speed" data-speed-preset>
							<option value="180">Slow / 180 WPM</option>
							<option value="230" selected>Default / 230 WPM</option>
							<option value="300">Fast / 300 WPM</option>
						</select>
					</label>
					<label class="reader-setting">
						<span>Line Height</span>
						<input class="reader-range" name="line-height" type="range" min="1.45" max="2.05" step="0.05" value="1.78" data-line-height />
					</label>
					<label class="reader-setting">
						<span>Letter Spacing</span>
						<input class="reader-range" name="letter-spacing" type="range" min="-0.01" max="0.06" step="0.005" value="0" data-letter-spacing />
					</label>
					<label class="reader-setting">
						<span>Font Scale</span>
						<input class="reader-range" name="font-scale" type="range" min="0.9" max="1.25" step="0.05" value="1" data-font-scale />
					</label>
					<div class="reader-setting">
						<span>Reading Width</span>
						<div class="reader-segment" role="group" aria-label="Reading width">
							<button type="button" data-reader-width="2xl" aria-pressed="true">2XL</button>
							<button type="button" data-reader-width="4xl" aria-pressed="false">4XL</button>
						</div>
					</div>
					<div class="reader-setting">
						<span>Progress Anchor</span>
						<label class="reader-switch">
							<input type="checkbox" data-progress-toggle checked />
							<span>Visible</span>
						</label>
					</div>
					<div class="reader-setting">
						<span>Typeface</span>
						<div class="reader-segment reader-segment--triple" role="group" aria-label="Typeface">
							<button type="button" data-font-choice="inter" aria-pressed="true">Inter</button>
							<button type="button" data-font-choice="charter" aria-pressed="false">Charter</button>
							<button type="button" data-font-choice="mono" aria-pressed="false">Mono</button>
						</div>
					</div>
					<div class="reader-setting reader-setting--wide">
						<span>Focus</span>
						<button class="zen-entry" type="button" data-zen-toggle aria-label="Enter Zen Mode" aria-pressed="false">
							<span>Zen Mode</span>
							<span aria-hidden="true">-&gt;</span>
						</button>
					</div>
				</div>
			</section>
		</div>
	</div>
</Layout>

<style>
	.reader-select,
	.reader-range {
		width: 100%;
		border: 1px solid rgb(229 229 229);
		background: #ffffff;
		color: #171717;
		padding: 0.5rem;
		font-size: 0.875rem;
	}

	:global([data-theme="dark"]) .reader-select,
	:global([data-theme="dark"]) .reader-range {
		border-color: rgb(38 38 38);
		background: #0a0a0a;
		color: #ffffff;
	}
</style>
