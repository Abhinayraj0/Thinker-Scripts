---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categories = [...new Set(posts.flatMap((post) => post.data.categories))].sort();
const types = [...new Set(posts.map((post) => post.data.type))].sort();
---

<Layout
	title="Topics in Tech Philosophy and Systems Design"
	description="Explore topics in tech philosophy, systems thinking software design, epistemology in tech, cognitive architectures for programming, and critical thinking in computer science."
	keywords={[
		'tech philosophy blog',
		'systems thinking software design',
		'epistemology in tech',
		'cognitive architectures for programming',
		'critical thinking in computer science',
		'mechanistic approach to problem solving in tech',
		'state machine logic in web layout design',
		'user interface mechanics for technical blogs',
	]}
>
	<section class="mx-auto max-w-7xl px-5 py-14 sm:px-6 lg:px-8">
		<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">TOPICS</p>
		<h1 class="mt-4 max-w-4xl text-5xl font-semibold leading-none text-pretty text-neutral-950 sm:text-7xl dark:text-white">
			Topics in tech philosophy and systems design.
		</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-neutral-600 dark:text-neutral-300">
			Browse essays by discipline and form, from epistemology in tech and critical thinking in computer science to interface mechanics for technical blogs.
		</p>
	</section>

	<section class="border-y border-neutral-200 bg-neutral-50 py-14 dark:border-neutral-800 dark:bg-neutral-950">
		<div class="mx-auto grid max-w-7xl gap-8 px-5 sm:px-6 lg:grid-cols-2 lg:px-8">
			<div>
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">DISCIPLINES</p>
				<div class="mt-5 grid gap-3">
					{categories.map((category) => {
						const count = posts.filter((post) => post.data.categories.includes(category)).length;
						return (
							<a class="topic-row" href={`/library/?category=${encodeURIComponent(category)}`}>
								<span>{category}</span>
								<strong>{count} {count === 1 ? 'essay' : 'essays'}</strong>
							</a>
						);
					})}
				</div>
			</div>
			<div>
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">ESSAY TYPES</p>
				<div class="mt-5 grid gap-3">
					{types.map((type) => {
						const count = posts.filter((post) => post.data.type === type).length;
						return (
							<a class="topic-row" href={`/library/?type=${encodeURIComponent(type)}`}>
								<span>{type}</span>
								<strong>{count} {count === 1 ? 'essay' : 'essays'}</strong>
							</a>
						);
					})}
				</div>
			</div>
		</div>
	</section>
</Layout>
