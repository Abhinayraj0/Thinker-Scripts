---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
	title?: string;
	description?: string;
	keywords?: string[];
	type?: 'website' | 'article';
	image?: string;
	publishedAt?: Date;
	updatedAt?: Date;
	zenCapable?: boolean;
	robots?: string;
}

const {
	title = 'Thinker Scripts',
	description = 'A tech philosophy blog about the philosophy of software engineering, systems thinking software design, and deep reading for developers.',
	keywords = [
		'philosophy of software engineering',
		'tech philosophy blog',
		'systems thinking software design',
		'epistemology in tech',
		'first principles software development',
		'deep reading for developers',
	],
	type = 'website',
	image = '/og-default.svg',
	publishedAt,
	updatedAt,
	zenCapable = false,
	robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;
const pageTitle = title === 'Thinker Scripts' ? title : `${title} | Thinker Scripts`;
const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://thinker-scripts.araj20164.workers.dev');
const staticPosts = (await getCollection('blog')).map((entry) => ({
	id: entry.id,
	title: entry.data.title,
	description: entry.data.description,
	publishedAt: entry.data.publishedAt.toISOString(),
	updatedAt: entry.data.updatedAt?.toISOString(),
	type: entry.data.type,
	categories: entry.data.categories,
	tags: entry.data.tags,
	readingMinutes: entry.data.readingMinutes,
	draft: entry.data.draft,
	body: entry.body,
}));
const canonical = new URL(path, site).toString();
const imageUrl = new URL(image, site).toString();
const navItems = [
	{ href: '/library/', label: 'Library', active: path.startsWith('/library') },
	{ href: '/topics/', label: 'Topics', active: path.startsWith('/topics') },
	{ href: '/posts/systems-that-remember/', label: 'Featured', active: path === '/posts/systems-that-remember/' },
	{ href: '/about-us/', label: 'About Us', active: path.startsWith('/about-us') || path.startsWith('/about') },
	{ href: '/control-center/', label: 'Control', active: path.startsWith('/control-center') },
];
const siteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Thinker Scripts',
	url: new URL('/', site).toString(),
	description,
	inLanguage: 'en',
	publisher: {
		'@type': 'Organization',
		name: 'Thinker Scripts',
		url: new URL('/', site).toString(),
	},
	about: keywords.slice(0, 8),
};
const pageSchema = {
	'@context': 'https://schema.org',
	'@type': type === 'article' ? 'BlogPosting' : 'WebPage',
	headline: pageTitle,
	name: pageTitle,
	description,
	url: canonical,
	image: imageUrl,
	keywords,
	inLanguage: 'en',
	isPartOf: {
		'@type': 'WebSite',
		name: 'Thinker Scripts',
		url: new URL('/', site).toString(),
	},
	author: {
		'@type': 'Organization',
		name: 'Thinker Scripts',
	},
	publisher: {
		'@type': 'Organization',
		name: 'Thinker Scripts',
		url: new URL('/', site).toString(),
	},
	...(publishedAt ? { datePublished: publishedAt.toISOString() } : {}),
	...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
};
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords.join(', ')} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#fafafa" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		<meta property="og:site_name" content="Thinker Scripts" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
		{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
		{type === 'article' && keywords.map((keyword) => <meta property="article:tag" content={keyword} />)}
		<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
		<script id="ts-static-posts" type="application/json" set:html={JSON.stringify(staticPosts)} />
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-TK6J4Z3JDS"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-TK6J4Z3JDS');
		</script>
		<script is:inline>
			const storedTheme = localStorage.getItem('ts-theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = storedTheme || (prefersDark ? 'dark' : 'light');
			document.documentElement.dataset.theme = theme;
			document.documentElement.style.colorScheme = theme;
		</script>
		{zenCapable && (
			<script is:inline>
				document.documentElement.classList.toggle('zen-active', localStorage.getItem('ts-zen') === 'true');
			</script>
		)}
	</head>
	<body class="min-h-screen bg-neutral-50 text-neutral-950 antialiased dark:bg-neutral-950 dark:text-white">
		<a class="skip-link" href="#main">Skip to Content</a>
		<header class="site-chrome sticky top-0 z-40 border-b border-neutral-200 bg-white/90 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/90">
			<nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8" aria-label="Main navigation">
				<a class="flex items-center gap-3 font-medium tracking-normal text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-950 dark:text-white dark:focus-visible:outline-white" href="/">
					<span class="grid h-7 w-7 place-items-center border border-neutral-950 bg-neutral-950 text-xs text-white dark:border-white dark:bg-white dark:text-neutral-950">TS</span>
					<span translate="no">Thinker Scripts</span>
				</a>
				<div class="hidden items-center gap-1 text-sm text-neutral-600 md:flex dark:text-neutral-300">
					{navItems.map((item) => (
						<a class="nav-link" href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
					))}
				</div>
				<div class="flex items-center gap-2">
					{zenCapable && (
						<button class="zen-switch" type="button" data-zen-toggle aria-label="Toggle Zen Mode" aria-pressed="false" title="Zen Mode">
							<span class="zen-switch__track" aria-hidden="true">
								<span class="zen-switch__label zen-switch__label--off">Off</span>
								<span class="zen-switch__label zen-switch__label--on">On</span>
								<span class="zen-switch__thumb">
									<svg class="zen-switch__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 12h4"></path>
										<path d="M16 12h4"></path>
										<path d="M8 12a4 4 0 0 1 8 0"></path>
										<path d="M8 12a4 4 0 0 0 8 0"></path>
									</svg>
								</span>
							</span>
						</button>
					)}
					<button class="theme-switch" type="button" data-theme-toggle aria-label="Toggle Dark Mode" aria-pressed="false" title="Theme">
						<span class="theme-switch__track" aria-hidden="true">
							<span class="theme-switch__thumb">
								<svg class="theme-switch__icon theme-switch__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="4"></circle>
									<path d="M12 2v2"></path>
									<path d="M12 20v2"></path>
									<path d="m4.93 4.93 1.41 1.41"></path>
									<path d="m17.66 17.66 1.41 1.41"></path>
									<path d="M2 12h2"></path>
									<path d="M20 12h2"></path>
									<path d="m6.34 17.66-1.41 1.41"></path>
									<path d="m19.07 4.93-1.41 1.41"></path>
								</svg>
								<svg class="theme-switch__icon theme-switch__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20.5 14.2A7.8 7.8 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"></path>
								</svg>
							</span>
						</span>
					</button>
				</div>
			</nav>
		</header>
		<main id="main" tabindex="-1">
			<slot />
		</main>
		{zenCapable && (
			<button class="zen-exit-btn" type="button" data-zen-exit aria-label="Exit Zen Mode">
				<span aria-hidden="true">x</span>
				<span>Exit Zen</span>
			</button>
		)}
		<button class="back-to-top fixed bottom-6 right-6 z-50 opacity-0 pointer-events-none scale-95 transition-all duration-300" type="button" data-back-to-top aria-label="Back to Top">
			<svg class="back-to-top__ring" viewBox="0 0 48 48" aria-hidden="true">
				<circle class="back-to-top__track" cx="24" cy="24" r="21"></circle>
				<circle class="back-to-top__progress" cx="24" cy="24" r="21" pathLength="100" data-back-to-top-progress></circle>
			</svg>
			<span class="back-to-top__icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m6 14 6-6 6 6"></path>
				</svg>
			</span>
		</button>
		<footer class="site-chrome border-t border-neutral-200 bg-white py-10 dark:border-neutral-800 dark:bg-neutral-950">
			<div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 text-sm text-neutral-500 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8 dark:text-neutral-400">
				<p>Copyright 2026 Thinker Scripts. Designed for focused long-form reading.</p>
				<div class="flex flex-wrap gap-4">
					<a class="hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="/library/">Index</a>
					<a class="hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="/topics/">Topics</a>
					<a class="hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="/about-us/">About Us</a>
					<a class="hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="/contact-us/">Contact Us</a>
					<a class="hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="/privacy-policy/">Privacy Policy</a>
					<a class="hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="/terms-and-conditions/">Terms & Conditions</a>
					<a class="hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" href="https://thinker-scripts.araj20164.workers.dev">workers.dev</a>
				</div>
			</div>
		</footer>
		<script type="module" src="/scripts/site.js"></script>
	</body>
</html>
