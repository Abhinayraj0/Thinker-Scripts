---
const faqs = [
	{
		question: 'What is a simple definition of philosophy?',
		answer:
			'Philosophy is the disciplined study of fundamental questions about knowledge, reality, reason, values, and how people should live. In software and technology, it helps developers examine assumptions before turning them into systems.',
	},
	{
		question: 'Do philosophy believe in God?',
		answer:
			'Philosophy itself does not believe or disbelieve in God. Philosophers study arguments about God, religion, consciousness, ethics, and existence, and different philosophers reach different conclusions.',
	},
	{
		question: 'What is the basic of philosophy?',
		answer:
			'The basics of philosophy include logic, ethics, metaphysics, epistemology, and critical reasoning. These areas teach people how to define ideas clearly, test claims, and reason from first principles.',
	},
	{
		question: 'Who is the most important philosopher?',
		answer:
			'There is no single most important philosopher for every tradition, but Plato, Aristotle, Socrates, Kant, Confucius, Descartes, and Nietzsche are often treated as major figures because their ideas shaped how people think about knowledge, ethics, politics, and reality.',
	},
	{
		question: 'Why is philosophy important?',
		answer:
			'Philosophy is important because it improves critical thinking, clarifies values, exposes weak assumptions, and helps people reason about difficult problems. For developers, philosophy supports better decisions in software design, automation, ethics, and systems thinking.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};
---

<section class="border-t border-neutral-200 bg-white py-14 dark:border-neutral-800 dark:bg-neutral-950">
	<div class="mx-auto max-w-5xl px-5 sm:px-6 lg:px-8">
		<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">PHILOSOPHY FAQ</p>
		<h2 class="mt-3 max-w-3xl text-3xl font-semibold text-neutral-950 dark:text-white">
			Frequently asked questions about philosophy.
		</h2>
		<div class="mt-8 divide-y divide-neutral-200 border-y border-neutral-200 dark:divide-neutral-800 dark:border-neutral-800">
			{faqs.map((faq) => (
				<details class="group py-5">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-semibold text-neutral-950 dark:text-white">
						<span>{faq.question}</span>
						<span class="grid h-7 w-7 shrink-0 place-items-center border border-neutral-200 text-sm text-neutral-500 transition-colors group-open:bg-neutral-950 group-open:text-white dark:border-neutral-800 dark:text-neutral-400 dark:group-open:bg-white dark:group-open:text-neutral-950" aria-hidden="true">+</span>
					</summary>
					<p class="mt-4 max-w-3xl text-sm leading-7 text-neutral-600 dark:text-neutral-300">{faq.answer}</p>
				</details>
			))}
		</div>
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
