---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	eyebrow?: string;
	title?: string;
	description?: string;
}

const {
	posts,
	eyebrow = 'CONTENT INDEX',
	title = 'Filter by intent.',
	description = 'Shape the library around the kind of essay, discipline, and reading window you want.',
} = Astro.props;

const types = [...new Set(posts.map((post) => post.data.type))];
const categories = [...new Set(posts.flatMap((post) => post.data.categories))];
const ranges = [
	{ label: '< 8 Min', value: 'short', min: 0, max: 8 },
	{ label: '8-15 Min', value: 'medium', min: 8, max: 15 },
	{ label: '15+ Min', value: 'long', min: 15, max: 999 },
];
---

<section class="border-y border-neutral-200 bg-neutral-50 py-14 dark:border-neutral-800 dark:bg-neutral-950">
	<div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8" data-library>
		<div class="flex flex-col gap-5 border-b border-neutral-200 pb-8 md:flex-row md:items-end md:justify-between dark:border-neutral-800">
			<div>
				<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400">{eyebrow}</p>
				<h2 class="mt-3 text-3xl font-semibold text-neutral-950 dark:text-white">{title}</h2>
			</div>
			<p class="max-w-xl text-sm leading-6 text-neutral-600 dark:text-neutral-400">{description}</p>
		</div>

		<div class="mt-8 grid gap-6 lg:grid-cols-[280px_1fr]">
			<aside class="h-fit border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-950">
				<div class="flex items-center justify-between">
					<h3 class="text-sm font-medium text-neutral-950 dark:text-white">Filters</h3>
					<button class="text-sm text-neutral-500 transition-colors hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 dark:hover:text-white dark:focus-visible:outline-white" type="button" data-clear-filters>
						Clear
					</button>
				</div>
				<div class="mt-5 space-y-6">
					<div>
						<p class="filter-label">Type</p>
						<div class="mt-3 flex flex-wrap gap-2" data-filter-group="type">
							{types.map((type) => <button class="filter-chip" type="button" data-filter="type" data-value={type}>{type}</button>)}
						</div>
					</div>
					<div>
						<p class="filter-label">Discipline</p>
						<div class="mt-3 flex flex-wrap gap-2" data-filter-group="category">
							{categories.map((category) => <button class="filter-chip" type="button" data-filter="category" data-value={category}>{category}</button>)}
						</div>
					</div>
					<div>
						<p class="filter-label">Reading Time</p>
						<div class="mt-3 flex flex-wrap gap-2" data-filter-group="time">
							{ranges.map((range) => <button class="filter-chip" type="button" data-filter="time" data-value={range.value} data-min={range.min} data-max={range.max}>{range.label}</button>)}
						</div>
					</div>
				</div>
			</aside>

			<div>
				<div class="mb-4 flex items-center justify-between text-sm text-neutral-500 dark:text-neutral-400">
					<span><strong class="font-medium text-neutral-950 dark:text-white" data-result-count>{posts.length}</strong> essays found</span>
					<span class="font-mono text-xs">REFINED RESULTS</span>
				</div>
				<div class="grid gap-4" data-post-list>
					{posts.map((post) => <PostCard post={post} />)}
				</div>
				<p class="hidden border border-neutral-200 bg-white p-6 text-sm text-neutral-500 dark:border-neutral-800 dark:bg-neutral-950" data-empty-state>
					No essays match this filter set.
				</p>
			</div>
		</div>
	</div>
</section>
