{
  "name": "tools",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:public": "npm run build && node scripts/prune-private-routes.mjs",
    "deploy": "npm run build:public && wrangler deploy",
    "deploy:workers": "npm run build:public && wrangler deploy",
    "deploy:pages": "npm run build:public && wrangler pages deploy dist --project-name thinker-scripts",
    "preview": "astro preview",
    "preview:workers": "npm run build && wrangler dev",
    "preview:pages": "npm run build && wrangler pages dev dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.98.0"
  }
}
